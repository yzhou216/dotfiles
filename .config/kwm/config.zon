.{
    // environment variables
    // used by processes spawned by kwm
    .env = .{},
    .working_directory = .home,

    // applications started when kwm starts (previously spawned from river init)
    .startup_cmds = .{
        // idle management: swayidle
        .{ "swayidle", "-w", "timeout", "100", "wlock" },
        // inhibit idle when audio is in use
        .{ "wayland-pipewire-idle-inhibit" },
        // dynamic display configuration: kanshi
        .{ "kanshi" },
        // notification daemon: fnott
        .{ "fnott" },
        // update D-Bus activation environment
        .{ "dbus-update-activation-environment", "--systemd", "DISPLAY", "WAYLAND_DISPLAY", "XDG_CURRENT_DESKTOP" },
        // built-in status bar clock writer (replaces yambar).
        // NOTE: the fifo must already exist before kwm starts, otherwise the
        // bar's fifo open races this child process and never retries. Create
        // it in the session startup, e.g. launch river as:
        //   river -c "sh -c 'mkdir -p ${XDG_RUNTIME_DIR}; mkfifo ${XDG_RUNTIME_DIR}/kwm-status 2>/dev/null; exec kwm'"
        // The `mkfifo` below is kept as a best-effort fallback only.
        .{ "sh", "-c", "while :; do date '+%H:%M:%S'; sleep 1; done > ${XDG_RUNTIME_DIR}/kwm-status" },
    },

    .xcursor_theme = null,

    // solid color background
    .background = 0x000000ff,

    .bar = .{
        .show_default = true,
        .position = .top,
        .font = "monospace:size=10",

        .scheme = .{
            .normal = .{
                .fg = 0xffffffff,
                .bg = 0x000000ff,
            },
            .select = .{
                .fg = 0x000000ff,
                .bg = 0x00ab41ff,
            },
        },

        // tags part
        .tags = .{
            // tags shown on the bar (1-5, t, w, e)
            .tags = .{ "1", "2", "3", "4", "5", "t", "w", "e" },
            .click = .{
                .left = .{ .set_output_tag = .{ .tag = .{ .tag = 0 } } },
                .right = .{ .toggle_output_tag = .{ .mask = 0 } },
                .middle = .{ .toggle_window_tag = .{ .mask = 0 } },
            },
        },
        .mode = .{
            .tags = .{
                .{ "default", "" },
                .{ "passthrough", "P" },
                .{ "floating", "F" },
            },
            .click = .{
                .left = .{ .switch_mode = .{ .mode = "default" } },
            },
        },
        .layout = .{
            .tags = .{
                .tile = .{
                    .left = "[]=",
                    .right = "=[]",
                    .top = "[^]",
                    .bottom = "[_]",
                },
                .grid = .{
                    .horizontal = "|+|",
                    .vertical = "|||",
                },
                .monocle = "[{{=}}]",
                .deck = .{
                    .left = "[{{D}}]=",
                    .right = "=[{{D}}]",
                    .top = "[{{D}}^]",
                    .bottom = "[{{D}}_]",
                },
                .scroller = "[==]",
                .centered_master = .{
                    .horizontal = "=[]=",
                    .vertical = "=[V]=",
                },
                .float = "><>",
            },
            .click = .{
                .left = .switch_to_previous_layout,
            },
        },
        .title = .{
            .click = .{
                .left = .{ .zoom = .{ .swap = false } },
            },
        },
        // status part fed by the fifo writer above (a clock)
        .status = .{
            .data = .{ .fifo = "${XDG_RUNTIME_DIR}/kwm-status" },
            .click = .{
                .middle = .{ .spawn = .{ .argv = .{ "alacritty" } } },
            },
        },

        .override_colors = .{
            // highlight the mode tag (shown in passthrough/floating mode)
            .{
                .area = .{ .mode = null },
                .scheme = .{
                    .normal = .{
                        .fg = 0x000000ff,
                        .bg = 0x00ab41ff,
                    },
                },
            },
        },
    },

    .single_tagset = false,
    .sloppy_focus = false,
    .cursor_warp = .none,
    .disable_wrap_around_for_scroller = false,
    .remember_floating_geometry = false,
    .auto_swallow = true,

    .default_attach_mode = .{
        .tile = .top,
        .grid = .top,
        .monocle = .top,
        .deck = .stack_top,
        .scroller = .below_focused,
        .centered_master = .top,
        .float = .top,
    },

    .default_window_decoration = .ssd,

    // window border
    .border = .{
        .width = 2,
        .color = .{
            .focus = 0x00ab41ff,
            .unfocus = 0x154734ff,
            .swallowing = 0x0830e6ff,
        },
    },

    // rivertile was the only layout used previously, keep it as the default
    .default_layout = .tile,
    .layout = .{
        .tile = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 3,
            .outer_gap = 0,
            .master_location = .left,
        },
        .grid = .{
            .outer_gap = 9,
            .inner_gap = 12,
            .direction = .horizontal,
        },
        .monocle = .{
            .gap = 9,
        },
        .deck = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,
            .master_location = .left,
        },
        .scroller = .{
            .mfact = 0.5,
            .inner_gap = 16,
            .outer_gap = 9,
        },
        .centered_master = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,
            .direction = .horizontal,
        },
    },

    .bindings = .{
        // keyboard repeat rate (river: set-repeat 50 300)
        .repeat_info = .{
            .rate = 50,
            .delay = 300,
        },

        .key = .{
            // reload config (kwm default)
            .{
                .keysym = "r",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .reload_config } },
            },

            // passthrough mode (kwm default + river's Super+F11)
            .{
                .keysym = "Escape",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "passthrough" } } } },
            },
            .{
                .mode = "passthrough",
                .keysym = "Escape",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "default" } } } },
            },
            .{
                .keysym = "F11",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "passthrough" } } } },
            },
            .{
                .mode = "passthrough",
                .keysym = "F11",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "default" } } } },
            },

            // floating mode (kwm default): move/resize/snap
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "floating", .auto_quit = .once_unbound_pressed } } } },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true },
                .event = .{ .repeat = .{ .move = .{ .step = .{ .horizontal = 10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true },
                .event = .{ .repeat = .{ .move = .{ .step = .{ .horizontal = -10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true },
                .event = .{ .repeat = .{ .move = .{ .step = .{ .vertical = 10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true },
                .event = .{ .repeat = .{ .move = .{ .step = .{ .vertical = -10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .repeat = .{ .resize = .{ .step = .{ .horizontal = 10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .repeat = .{ .resize = .{ .step = .{ .horizontal = -10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .repeat = .{ .resize = .{ .step = .{ .vertical = 10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .repeat = .{ .resize = .{ .step = .{ .vertical = -10 } } } },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .snap = .{ .edge = .right } } } },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .snap = .{ .edge = .left } } } },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .snap = .{ .edge = .bottom } } } },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .snap = .{ .edge = .top } } } },
            },

            // quit the river session (Super+Ctrl+E from river init, keep kwm default too)
            .{
                .keysym = "q",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .quit = .{ .exit_session = true } } } },
            },
            .{
                .keysym = "e",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .{ .quit = .{ .exit_session = true } } } },
            },

            // close the focused window (Super+Alt+Q from river init, keep kwm default too)
            .{
                .keysym = "c",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .close } },
            },
            .{
                .keysym = "q",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{ .click = .{ .pressed = .close } },
            },

            // terminal emulator: alacritty (Super+Return) and zoom (Super+Shift+Return)
            .{
                .keysym = "Return",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "alacritty" } } } } },
            },
            .{
                .keysym = "Return",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .zoom = .{ .swap = true } } } },
            },

            // focus the next/previous view in the layout stack
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .forward } } } },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .reverse } } } },
            },
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .forward, .skip = .floating } } } },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .reverse, .skip = .floating } } } },
            },
            .{
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .focus_master_return } },
            },
            .{
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .focus_master_return } },
            },

            // swap the focused view with the next/previous
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .forward } } } },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .reverse } } } },
            },

            // focus/send to the next/previous output
            .{
                .keysym = "period",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .focus_output_iter = .{ .direction = .forward } } } },
            },
            .{
                .keysym = "comma",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .focus_output_iter = .{ .direction = .reverse } } } },
            },
            .{
                .keysym = "period",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .send_to_output = .{ .direction = .forward } } } },
            },
            .{
                .keysym = "comma",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .send_to_output = .{ .direction = .reverse } } } },
            },

            // fullscreen/maximize
            .{
                .keysym = "m",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .toggle_fullscreen = .{ .in_window = true } } } },
            },
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .toggle_fullscreen = .{ .in_window = false } } } },
            },
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .toggle_fullscreen = .{ .in_window = false } } } },
            },
            .{
                .keysym = "e",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .toggle_maximize } },
            },

            // toggle the status bar
            .{
                .keysym = "b",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .toggle_bar } },
            },

            // layout switching
            .{
                .keysym = "space",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .switch_to_previous_layout } },
            },
            .{
                .keysym = "g",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_layout = .{ .layout = .grid } } } },
            },
            .{
                .keysym = "m",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_layout = .{ .layout = .monocle } } } },
            },
            .{
                .keysym = "u",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_layout = .{ .layout = .centered_master } } } },
            },
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{ .click = .{ .pressed = .{ .switch_layout = .{ .layout = .float } } } },
            },

            // floating/sticky/swallow
            .{
                .keysym = "s",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{ .click = .{ .pressed = .toggle_sticky } },
            },
            .{
                .keysym = "a",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .toggle_swallow } },
            },
            .{
                .keysym = "a",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .toggle_auto_swallow } },
            },

            // previous tag and tag shifting
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .switch_to_previous_tag } },
            },
            .{
                .keysym = "apostrophe",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .occupied = .forward } } } } },
            },
            .{
                .keysym = "semicolon",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .occupied = .reverse } } } } },
            },
            .{
                .keysym = "apostrophe",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .unoccupied = .forward } } } } },
            },
            .{
                .keysym = "semicolon",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .unoccupied = .reverse } } } } },
            },

            // tags 1-5, t, w, e
            .{ .keysym = "1", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000 } } } } } },
            .{ .keysym = "t", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100000 } } } } } },
            .{ .keysym = "w", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000000 } } } } } },
            .{ .keysym = "e", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000000 } } } } } },
            .{ .keysym = "0", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b11111111 } } } } } },

            // toggle output tag (kwm default)
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b1 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b10 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b100 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b1000 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b10000 } } } } },
            .{ .keysym = "t", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b100000 } } } } },
            .{ .keysym = "w", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b1000000 } } } } },
            .{ .keysym = "e", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 0b10000000 } } } } },

            // tag focused view with tag (Super+Shift+1-5, t, w, e)
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000 } } } } } },
            .{ .keysym = "t", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100000 } } } } } },
            .{ .keysym = "w", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000000 } } } } } },
            .{ .keysym = "e", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000000 } } } } } },
            .{ .keysym = "0", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b11111111 } } } } } },

            // toggle tag of focused view (Super+Shift+Ctrl+1-5, t, w, e)
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b1 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b10 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b100 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b1000 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b10000 } } } } },
            .{ .keysym = "t", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b100000 } } } } },
            .{ .keysym = "w", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b1000000 } } } } },
            .{ .keysym = "e", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 0b10000000 } } } } },

            // decrease/increase the main ratio of the master area (river: main-ratio)
            .{
                .keysym = "l",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_mfact = .{ .change = .{ .step = 0.05 } } } } },
            },
            .{
                .keysym = "h",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_mfact = .{ .change = .{ .step = -0.05 } } } } },
            },

            // decrease/increase the number of windows in the master area (river: main-count)
            .{
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .increase } } } },
            },
            .{
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .decrease } } } },
            },
            .{
                .keysym = "equal",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .increase } } } },
            },
            .{
                .keysym = "minus",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .decrease } } } },
            },

            // change layout orientation (river: main-location)
            .{
                .keysym = "Up",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_master_location = .{ .location = .top } } } },
            },
            .{
                .keysym = "Right",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_master_location = .{ .location = .right } } } },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_master_location = .{ .location = .bottom } } } },
            },
            .{
                .keysym = "Left",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_master_location = .{ .location = .left } } } },
            },

            // decrease/increase the gaps
            .{
                .keysym = "equal",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_gap = .{ .step = 1 } } } },
            },
            .{
                .keysym = "minus",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{ .click = .{ .pressed = .{ .modify_gap = .{ .step = -1 } } } },
            },

            // toggle grid/centered master layout direction
            .{
                .keysym = "g",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .toggle_grid_direction } },
            },
            .{
                .keysym = "u",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .toggle_centered_master_direction } },
            },

            // launcher: wmenu
            .{
                .keysym = "d",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "pkill wmenu; wmenu-run -l 24 -N 000000ff" } } } },
            },
            .{
                .keysym = "p",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wmenu-run" } } } },
            },

            // notification daemon: fnott
            .{
                .keysym = "c",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "fnottctl dismiss all" } } } },
            },

            // screenshots: wayshot
            .{
                .keysym = "s",
                .modifiers = .{ .mod4 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wayshot - | wl-copy -t image/png; wayshot -- \"$HOME/Pictures/Screenshots/$(date +%s%N | cut -b1-13)-wayshot.png\"" } } } },
            },
            .{
                .keysym = "s",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "region=$(slurp); wayshot --geometry \"$region\" - | wl-copy -t image/png; wayshot --geometry \"$region\" -- \"$HOME/Pictures/Screenshots/$(date +%s%N | cut -b1-13)-wayshot.png\"" } } } },
            },

            // session lock: wlock
            .{
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "wlock" } } } } },
            },

            // media keys (normal mode)
            .{
                .keysym = "XF86Eject",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "eject", "-T" } } } } },
            },
            .{
                .keysym = "XF86AudioRaiseVolume",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "-i", "5" } } } } },
            },
            .{
                .keysym = "XF86AudioLowerVolume",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "-d", "5" } } } } },
            },
            .{
                .keysym = "XF86AudioMute",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "--toggle-mute" } } } } },
            },
            .{
                .keysym = "XF86AudioMedia",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "play-pause" } } } } },
            },
            .{
                .keysym = "XF86AudioPlay",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "play-pause" } } } } },
            },
            .{
                .keysym = "XF86AudioPrev",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "previous" } } } } },
            },
            .{
                .keysym = "XF86AudioNext",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "next" } } } } },
            },
            .{
                .keysym = "XF86MonBrightnessUp",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "xbacklight", "-inc", "10" } } } } },
            },
            .{
                .keysym = "XF86MonBrightnessDown",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "xbacklight", "-dec", "10" } } } } },
            },

            // media keys (locked mode)
            .{
                .mode = "lock",
                .keysym = "XF86Eject",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "eject", "-T" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioRaiseVolume",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "-i", "5" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioLowerVolume",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "-d", "5" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioMute",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "pamixer", "--toggle-mute" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioMedia",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "play-pause" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioPlay",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "play-pause" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioPrev",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "previous" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86AudioNext",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "playerctl", "next" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86MonBrightnessUp",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "xbacklight", "-inc", "10" } } } } },
            },
            .{
                .mode = "lock",
                .keysym = "XF86MonBrightnessDown",
                .modifiers = .{},
                .event = .{ .click = .{ .pressed = .{ .spawn = .{ .argv = .{ "xbacklight", "-dec", "10" } } } } },
            },
        },

        // mouse keybindings
        .pointer = .{
            .{
                .mode = "default",
                .button = .left,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_move },
            },
            .{
                .mode = "default",
                .button = .right,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_resize },
            },
        },
    },

    // window rules
    // note: only the first matching rule is applied
    .window_rules = .{
        // kwm defaults
        .{ .app_id = .{ .str = "", .match_null = true }, .floating = true },
        .{ .app_id = .{ .str = "zenity" }, .floating = true },
        .{ .app_id = .{ .str = "DesktopEditors" }, .floating = true },
        .{ .app_id = .{ .str = "xdg-desktop-portal-gtk" }, .floating = true },
        // make alacritty swallowable
        .{ .app_id = .{ .str = "alacritty" }, .is_terminal = true },
        // from river init: float windows with app-id starting with "float" and title "foo"
        .{ .app_id = .{ .str = "^float.*", .regex = true }, .title = .{ .str = "foo" }, .floating = true },
        // from river init: client-side decorations for app-id "bar"
        .{ .app_id = .{ .str = "bar" }, .decoration = .csd },
    },

    .output_rules = .{},
}
